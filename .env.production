# MausamIQ production environment.
#
# Loaded by Vite only for `vite build` (mode=production), so `npm run dev` still
# falls back to http://localhost:5000 in src/services/weatherApi.ts.
#
# This file is intentionally committed: every VITE_* value is inlined into the
# client bundle at build time, so it can never hold a secret. Only public values
# belong here.

VITE_API_BASE_URL=https://mausamiq-backend.onrender.com
